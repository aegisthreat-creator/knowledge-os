# KnowledgeOS environment configuration (placeholders only — no real credentials).

# Path to the SQLite database file, relative to the project root (or absolute).
# Defaults to: data/knowledge.db
DATABASE_PATH=data/knowledge.db

# Where uploaded document files are stored, relative to the project root.
# Defaults to: data/uploads
UPLOAD_DIR=data/uploads

# Ollama base URL used when no URL has been saved in Settings yet.
# Defaults to: http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Maximum accepted upload size in megabytes. Defaults to: 25
MAX_UPLOAD_MB=25
